# Development .env for docker-compose.dev.yml
# Copy this file to .env before running:
#   docker compose -f docker-compose.dev.yml up --build

# Usually keep defaults.
DEV_FRONTEND_PORT=5250
BACKEND_PORT=127.0.0.1:8090
DEV_PB_URL=http://127.0.0.1:8090
VITE_ALLOWED_HOSTS=true

# Initial Fangji business admin user.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-please
APP_ADMIN_NAME=管理员

# Optional: PocketBase Admin UI account for /_/.
PB_ADMIN_EMAIL=pb-admin@example.com
PB_ADMIN_PASSWORD=change-me-please-too

# Usually empty in development.
PB_ALLOWED_ORIGINS=

# Optional HTTPS base URL for the “兴化语记” identity service.
HINGHWA_IDENTITY_BASE_URL=
