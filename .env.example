# Production entrypoints
FRONTEND_PORT=8080
BACKEND_PORT=127.0.0.1:8090

# Leave empty for same-origin deployments.
# Set it only when the browser should talk to a different PocketBase origin.
BACKEND_URL=

# Deprecated compatibility alias. Prefer BACKEND_URL for new deployments.
PB_URL=

# Optional CORS allow list for cross-origin deployments.
# Example: PB_ALLOWED_ORIGINS=https://fangji.example.com
PB_ALLOWED_ORIGINS=

# Initial business admin user for the Fangji app.
# Set these before the first production startup.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-please
APP_ADMIN_NAME=管理员

# Optional PocketBase Admin UI account for /_/.
# This is separate from the Fangji business admin above.
PB_ADMIN_EMAIL=pb-admin@example.com
PB_ADMIN_PASSWORD=change-me-please-too

# Development compose defaults
DEV_FRONTEND_PORT=5250
DEV_PB_URL=http://127.0.0.1:8090
VITE_ALLOWED_HOSTS=true
